.controls{
  display: flex;
  justify-content: space-around;
  position: fixed; 
  bottom: 100rpx; 
  left: 0; 
  right: 0;
}

.shutter{
  width: 160rpx; 
  height: 160rpx; 
  border-radius: 50%; 
  background-color: #ff4d4f; 
  color: white;
  text-align: center;
  line-height: 160rpx;
}



.camera{
  width: 100%;
  height: 100vh;
}

.switch-btn{
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 40rpx;
}